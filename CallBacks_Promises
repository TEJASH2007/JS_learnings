// async await
// async function always returns the promise

async function sayHello(){
    console.log("Hello");
}
// we don't have to return the resolve or reject explicitly 
// it already ibuilt return as promise by the function

// await  pauses the pauses the execution of its surrounding async function until the 
// promise is settled
//  means if i have the code line like await function tejash() then until the surrounding 
// async functions complete their execution tejash will wait 
//  ##########      Remark : we can use the await keyword only in the async function #####

function api(){
    return new Promise((resolve , reject)=>{
        setTimeout(()=>{
            console.log("Whethe Data : " , 20);
            resolve(200);
        } , 2000);
    });
}

async function getWeatherData(){
    await api();   // first wait for the completion of the api then go to next line of code
    await api();
}

// iife  : immediately invoked function expression

(function sayHello(){
    console.log("Hello");
})();
